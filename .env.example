# ---------------------------------------------------------------------------
# SLM Feedback Harness — environment
# Copy to .env:  cp .env.example .env
# Every var has a safe default in src/util/config.ts; set only what you need.
# ---------------------------------------------------------------------------

# === Main path: the SLM engine (your own models, no frontier key) ==========
# Pin the model you host per tool. After Distil Labs trains from your seeds,
# download each SLM (`distil slm download`), convert the safetensors to GGUF
# (llama.cpp convert_hf_to_gguf.py), `ollama create` it, and pin it here:
#   TOOL_NARRATOR_MODEL=posthog-narrator
#   TOOL_EXTRACTOR_MODEL=posthog-extractor
#   TOOL_PRIORITIZER_MODEL=posthog-prioritizer
# Leave blank to fall back to the generic OLLAMA_MODEL below.
TOOL_NARRATOR_MODEL=
TOOL_EXTRACTOR_MODEL=
TOOL_PRIORITIZER_MODEL=

# Where the SLM engine runs.
#   ollama            -> local Ollama daemon (default)
#   openai-compatible -> any OpenAI-compatible runtime (vLLM, LM Studio, Groq,
#                        Together, a Cloudflare Worker fronting your weights)
SLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b          # generic placeholder until your models are pinned
# OLLAMA_EMBED_MODEL=nomic-embed-text  # embeddings for finding dedup (ollama pull nomic-embed-text);
#                                      # without it the demo falls back to lexical dedup

# For SLM_PROVIDER=openai-compatible, point at your runtime:
# OPENAI_BASE_URL=https://your-endpoint/v1
# OPENAI_MODEL=your-model
# OPENAI_API_KEY=dummy-or-real

# Optional per-tool overrides (rarely needed):
# TOOL_NARRATOR_ENGINE=slm       # force slm|llm for one tool
# TOOL_NARRATOR_LLM_PROVIDER=anthropic

# === Optional teacher path (frontier model) ================================
# Only needed for `bun run collect-training` (labeling your own PostHog data)
# or `bun run demo --engine llm`. Not required for the main SLM path.
LLM_PROVIDER=anthropic           # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# === PostHog (only for ingesting real sessions) ============================
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.i.posthog.com

# === Misc ===================================================================
DRY_RUN=1                        # 1 disables external writes (PostHog/GitHub/etc.)
LOG_LEVEL=INFO                   # DEBUG | INFO | WARN | ERROR
DATA_DIR=./data
